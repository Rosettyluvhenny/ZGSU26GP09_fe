# Local development only. Copy to .env (git-ignored) and fill in your keys.
#
# These are read by ui5-middleware-sap-proxy.js to stand in for the BTP
# destinations while running `npm start`. They are NEVER bundled into the app —
# in deployed environments the keys live in the AI_GROQ / AI_OPENROUTER
# destinations and are attached by the approuter. See README.md.
#
# Groq (~1k req/day free):   https://console.groq.com
# OpenRouter (~50 req/day):  https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
