# build results
dist
coverage
report
.nyc_output

# MTA build artifacts
Makefile_*.mta
mta_archives/
*.mtar

# Packaged app archives — build output, never source.
# ui5-task-zipper writes the app zip on every build; these were tracked and
# dirtied the tree on every run (FLP_MIGRATION.md deferred finding B).
archive.zip
resources/*.zip

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# Local Claude Code tooling — dev-server launch config and the capstone-docs
# skill. Kept on disk, out of the repo: it drives nobody's build or deploy.
.claude/

# JetBrains IDE settings — per-developer, not project config.
.idea/

.DS_Store

# AI provider keys for local dev only — copy .env.example to .env.
# Deployed environments get them from the AI_GROQ / AI_OPENROUTER destinations.
.env
