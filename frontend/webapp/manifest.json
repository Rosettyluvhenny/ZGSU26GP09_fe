{
	"_version": "2.0.0",
	"sap.app": {
		"id": "com.zgp09.fe",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "${version}"
		},
		"sourceTemplate": {
			"id": "@ui5/mcp-server:ts",
			"version": "0.2.14"
		},
		"dataSources": {
			"mainService": {
				"uri": "sap/opu/odata4/sap/zsb_gsugp9/srvd_a2x/sap/zsr_registry/0001/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"Registry-Display": {
					"semanticObject": "Registry",
					"action": "Display",
					"title": "Registry Control Center",
					"subTitle": "Manage registries, versions, and scan jobs",
					"icon": "sap-icon://database",
					"info": "",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.cloud": {
		"service": "zgp9",
		"public": true
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "com.zgp09.fe.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.149.1",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.tnt": {},
				"sap.ui.layout": {}
			}
		},
		"flexEnabled": false,
		"handleValidation": true,
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.zgp09.fe.i18n.i18n",
					"async": true
				}
			},
			"": {
				"type": "sap.ui.model.odata.v4.ODataModel",
				"dataSource": "mainService",
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "com.zgp09.fe.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "home",
					"target": "homePage"
				},
				{
					"pattern": "registries:?query:",
					"name": "registryList",
					"target": "registryList"
				},
				{
					"pattern": "registries/{registryId}",
					"name": "registryDetail",
					"target": "registryDetail"
				},
				{
					"pattern": "registries/{registryId}/versions/{versionId}:?query:",
					"name": "versionDetail",
					"target": "versionDetail"
				},
				{
					"pattern": "registries/{registryId}/versions/{versionId}/model:?query:",
					"name": "modelExplorer",
					"target": "modelExplorer"
				},
				{
					"pattern": "registries/{registryId}/versions/compare/{leftVersionId}/{rightVersionId}",
					"name": "versionCompare",
					"target": "versionCompare"
				},
				{
					"pattern": "registries/{registryId}/versions/compare/{leftVersionId}/{rightVersionId}/detail/{baseDetailId}/{compareDetailId}",
					"name": "detailCompare",
					"target": "detailCompare"
				},
				{
					"pattern": "jobs",
					"name": "jobList",
					"target": "jobList"
				},
				{
					"pattern": "jobs/{jobId}",
					"name": "jobDetail",
					"target": [
						"jobList",
						"jobDetail"
					]
				},
				{
					"pattern": "logs:?query:",
					"name": "logs",
					"target": "logs"
				}
			],
			"targets": {
				"shell": {
					"id": "shell",
					"name": "MainShell"
				},
				"homePage": {
					"id": "homePage",
					"name": "Home",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				},
				"registryList": {
					"id": "registryList",
					"name": "RegistryList",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				},
				"registryDetail": {
					"id": "registryDetail",
					"name": "RegistryDetail",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				},
				"versionDetail": {
					"id": "versionDetail",
					"name": "VersionDetail",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				},
				"modelExplorer": {
					"id": "modelExplorer",
					"name": "ModelExplorer",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				},
				"versionCompare": {
					"id": "versionCompare",
					"name": "VersionCompare",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				},
				"detailCompare": {
					"id": "detailCompare",
					"name": "DetailCompare",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				},
				"jobList": {
					"id": "jobList",
					"name": "JobList",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				},
				"jobDetail": {
					"id": "jobDetail",
					"name": "JobDetail",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "midColumnPages"
				},
				"logs": {
					"id": "logs",
					"name": "Logs",
					"parent": "shell",
					"controlId": "shellFcl",
					"controlAggregation": "beginColumnPages"
				}
			}
		}
	}
}