<mvc:View
	controllerName="com.zgp09.fe.controller.Logs"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f">

	<f:DynamicPage id="logsPage" toggleHeaderOnTitleClick="false" preserveHeaderStateOnScroll="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<HBox alignItems="Center">
						<Title text="Logs" level="H1" />
						<ObjectStatus text="{logList>/countLabel}" state="Information" class="sapUiSmallMarginBegin" />
					</HBox>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<VBox width="100%">
					<MessageStrip
						text="Filtered by Scan Job: {logList>/activeJobLabel}"
						type="Information"
						visible="{= !!${logList>/activeJobLabel} }"
						showCloseButton="true"
						close=".onClearJobFilter"
						class="sapUiSmallMarginBottom" />
					<OverflowToolbar design="Transparent" style="Clear">
						<Button text="Go" type="Emphasized" press=".onGo" />
						<Button text="Clear" press=".onClearFilters" />
						<Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh" />
					</OverflowToolbar>
					<HBox wrap="Wrap" alignItems="End" class="sapUiTinyMarginTop">
						<VBox class="sapUiSmallMarginEnd">
							<Label text="Action" />
							<Select width="11rem" selectedKey="{logList>/actionType}" items="{logList>/actionTypeOptions}" change=".onFilterChange">
								<core:Item key="{logList>key}" text="{logList>text}" />
							</Select>
						</VBox>
						<VBox class="sapUiSmallMarginEnd">
							<Label text="Result" />
							<Select width="10rem" selectedKey="{logList>/logResult}" items="{logList>/logResultOptions}" change=".onFilterChange">
								<core:Item key="{logList>key}" text="{logList>text}" />
							</Select>
						</VBox>
						<VBox class="sapUiSmallMarginEnd">
							<Label text="Object Type" />
							<Select width="11rem" selectedKey="{logList>/objectIdType}" items="{logList>/objectIdTypeOptions}" change=".onFilterChange">
								<core:Item key="{logList>key}" text="{logList>text}" />
							</Select>
						</VBox>
						<VBox class="sapUiSmallMarginEnd">
							<Label text="Created At" />
							<DateRangeSelection width="16rem" placeholder="Filter by date" displayFormat="medium" change=".onDateRangeChange" />
						</VBox>
						<VBox>
							<Label text="Global Search" />
							<SearchField width="18rem" placeholder="Search type, remarks, actor, Object ID…" value="{logList>/search}" liveChange=".onSearchLiveChange" search=".onSearch" />
						</VBox>
					</HBox>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox width="100%">
				<Table
					id="logTable"
					items="{logList>/items}"
					busy="{logList>/busy}"
					mode="None"
					sticky="ColumnHeaders"
					noDataText="No log entries found.">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Log Entries" level="H2" />
							<ToolbarSpacer />
							<ObjectStatus text="{logList>/countLabel}" state="Information" />
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column width="11rem"><Text text="Created At" /></Column>
						<Column width="9rem"><Text text="Action" /></Column>
						<Column width="8rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Result" /></Column>
						<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Actor" /></Column>
						<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Object Type" /></Column>
						<Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Object ID" /></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRowPress">
							<cells>
								<Text text="{path: 'logList>actionAt', formatter: '.formatDateTime'}" />
								<ObjectStatus text="{logList>actionText}" state="{path: 'logList>actionText', formatter: '.formatLogActionState'}" />
								<ObjectStatus text="{logList>logResult}" state="{path: 'logList>logResult', formatter: '.formatLogResultState'}" />
								<Text text="{logList>actor}" />
								<Text text="{logList>objectIdType}" />
								<Text text="{path: 'logList>objectId', formatter: '.formatShortId'}" tooltip="{logList>objectId}" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<OverflowToolbar design="Transparent" visible="{logList>/hasMore}">
					<ToolbarSpacer />
					<Button
						text="More"
						icon="sap-icon://slim-arrow-down"
						type="Transparent"
						press=".onLoadMore"
						busy="{logList>/loadingMore}"
						enabled="{= !${logList>/loadingMore} }" />
					<ToolbarSpacer />
				</OverflowToolbar>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>
