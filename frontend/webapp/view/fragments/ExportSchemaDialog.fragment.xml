<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">

	<Dialog id="exportSchemaDialog" title="Export Schema" draggable="true" resizable="true" contentWidth="25rem" busy="{exportSchema>/busy}">
		<beginButton>
			<Button text="Export" type="Emphasized" icon="sap-icon://download" press=".onConfirmExportSchema" />
		</beginButton>
		<endButton>
			<Button text="Cancel" press=".onCancelExportSchema" />
		</endButton>
		<content>
			<VBox class="sapUiSmallMargin" width="100%">
				<RadioButtonGroup id="exportFormatGroup" selectedIndex="{exportSchema>/selectedFormatIndex}">
					<RadioButton text="OpenAPI" />
					<RadioButton text="Dart" />
					<RadioButton text="Kotlin" />
					<RadioButton text="Swift" />
					<RadioButton text="JSON Schema" />
					<RadioButton text="TypeScript" />
				</RadioButtonGroup>
			</VBox>
		</content>
	</Dialog>

</core:FragmentDefinition>
