<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">

	<Dialog id="logDetailDialog" title="Log Entry Detail" draggable="true" resizable="true" contentWidth="40rem">
		<content>
			<form:SimpleForm layout="ResponsiveGridLayout" columnsL="1" columnsM="1" editable="false" class="sapUiContentPadding">
				<form:content>
					<Label text="Log ID" />
					<Text text="{logList>/selectedLog/logId}" />
					<Label text="Created At" />
					<Text text="{path: 'logList>/selectedLog/actionAt', formatter: '.formatDateTime'}" />
					<Label text="Action" />
					<ObjectStatus text="{logList>/selectedLog/actionText}" state="{path: 'logList>/selectedLog/actionText', formatter: '.formatLogActionState'}" />
					<Label text="Result" />
					<ObjectStatus text="{logList>/selectedLog/logResult}" state="{path: 'logList>/selectedLog/logResult', formatter: '.formatLogResultState'}" />
					<Label text="Actor" />
					<Text text="{logList>/selectedLog/actor}" />
					<Label text="IP Address" />
					<Text text="{= ${logList>/selectedLog/ipAddress} || '—' }" />
					<Label text="Object Type" />
					<Text text="{logList>/selectedLog/objectIdType}" />
					<Label text="Object ID" />
					<Text text="{= ${logList>/selectedLog/objectId} || '—' }" />
					<Label text="Job ID" />
					<Text text="{= ${logList>/selectedLog/jobId} || '—' }" />
					<Label text="Remarks" />
					<Text text="{logList>/selectedLog/remarks}" />
				</form:content>
			</form:SimpleForm>
		</content>
		<beginButton>
			<Button
				text="{= ${logList>/selectedLog/objectIdType} === 'VERSION' ? 'Open Version' : (${logList>/selectedLog/objectIdType} === 'DETAIL' ? 'Open Detail' : 'Open Registry') }"
				type="Emphasized"
				icon="sap-icon://business-objects-experience"
				visible="{= (${logList>/selectedLog/objectIdType} === 'REGISTRY' || ${logList>/selectedLog/objectIdType} === 'VERSION' || ${logList>/selectedLog/objectIdType} === 'DETAIL') &amp;&amp; !!${logList>/selectedLog/objectId} }"
				press=".onNavigateToObject" />
		</beginButton>
		<endButton>
			<Button text="Close" press=".onCloseDetailDialog" />
		</endButton>
	</Dialog>

</core:FragmentDefinition>
