<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">

	<Dialog id="registryDialog" title="{registryDialog>/title}" draggable="true" resizable="true" contentWidth="44rem" busy="{registryDialog>/busy}">
		<beginButton>
			<Button text="{= ${registryDialog>/mode} === 'create' ? 'Create' : 'Update' }" type="Emphasized" press=".onSaveRegistryDialog" />
		</beginButton>
		<endButton>
			<Button text="Cancel" press=".onCancelRegistryDialog" />
		</endButton>
		<content>
			<VBox class="sapUiSmallMargin" width="100%">
				<Text text="Create collects Group Name, Group Type, and Version No. Update only patches Status." wrapping="true" />
				<form:Form editable="true">
					<form:layout>
						<form:ColumnLayout columnsXL="1" columnsL="1" columnsM="1" />
					</form:layout>
					<form:formContainers>
						<form:FormContainer title="Create Registry" visible="{= ${registryDialog>/mode} === 'create' }">
							<form:formElements>
								<form:FormElement label="Group Name">
									<form:fields>
										<Input value="{registryDialog>/groupName}" required="true" maxLength="36" />
									</form:fields>
								</form:FormElement>
								<form:FormElement label="Group Type">
									<form:fields>
										<Select selectedKey="{registryDialog>/groupType}" forceSelection="true" items="{registryDialog>/groupTypes}">
											<core:Item key="{registryDialog>key}" text="{registryDialog>text}" />
										</Select>
									</form:fields>
								</form:FormElement>
								<form:FormElement label="Version No" visible="{= ${registryDialog>/groupType} !== '2' }">
									<form:fields>
										<Input value="{registryDialog>/versionNo}" required="{= ${registryDialog>/groupType} === '1' }" maxLength="6" placeholder="001" />
									</form:fields>
								</form:FormElement>
							</form:formElements>
						</form:FormContainer>

						<form:FormContainer title="Update Registry" visible="{= ${registryDialog>/mode} === 'edit' }">
							<form:formElements>
								<form:FormElement label="Registry Name">
									<form:fields>
										<Text text="{registryDialog>/groupName}" />
									</form:fields>
								</form:FormElement>
								<form:FormElement label="Status">
									<form:fields>
										<Select selectedKey="{registryDialog>/status}" forceSelection="true" items="{registryDialog>/statuses}">
											<core:Item key="{registryDialog>key}" text="{registryDialog>text}" />
										</Select>
									</form:fields>
								</form:FormElement>
							</form:formElements>
						</form:FormContainer>
					</form:formContainers>
				</form:Form>
			</VBox>
		</content>
	</Dialog>

</core:FragmentDefinition>
