<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">

	<Dialog id="sendMailDialog" title="Send Comparison Email" draggable="true" resizable="true" contentWidth="40rem" busy="{sendMail>/busy}">
		<beginButton>
			<Button text="Send" type="Emphasized" icon="sap-icon://email" press=".onConfirmSendMail" />
		</beginButton>
		<endButton>
			<Button text="Cancel" press=".onCancelSendMail" />
		</endButton>
		<content>
			<VBox class="sapUiSmallMargin" width="100%">
			<form:SimpleForm editable="true" layout="ColumnLayout">

				<Label text="Recipients" required="true" />
				<Input
					value="{sendMail>/recipients}"
					valueState="{sendMail>/recipientsState}"
					valueStateText="{sendMail>/recipientsStateText}"
					placeholder="user@example.com; user2@example.com"
					maxLength="500"
					type="Email"
					liveChange=".onRecipientsLiveChange" />

				<Label text="Subject" required="true" />
				<Input
					value="{sendMail>/subject}"
					valueState="{sendMail>/subjectState}"
					valueStateText="{sendMail>/subjectStateText}"
					placeholder="XML Comparison Report"
					maxLength="200" />

				<Label text="Email Content" />
				<SegmentedButton
					selectedKey="{sendMail>/emailMode}"
					width="100%">
					<items>
						<SegmentedButtonItem key="diff" text="Diff Only (recommended)" icon="sap-icon://compare" />
						<SegmentedButtonItem key="full" text="Full XML" icon="sap-icon://document-text" />
					</items>
				</SegmentedButton>

			</form:SimpleForm>

			<Text
				text="{= ${sendMail>/emailMode} === 'diff' ? 'Only changed lines with 3-line context will be included. Small email size, Gmail compatible.' : 'Full XML of both versions will be included. Email may be large (&gt;100KB) and Gmail might truncate it.' }"
				class="sapUiSmallMarginTop"
				wrapping="true"
				renderWhitespace="false" />
			</VBox>
		</content>
	</Dialog>

</core:FragmentDefinition>
