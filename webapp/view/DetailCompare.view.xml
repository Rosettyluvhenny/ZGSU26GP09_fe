<mvc:View
	controllerName="com.zgp9.fe.controller.DetailCompare"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout">

	<f:DynamicPage id="detailComparePage" toggleHeaderOnTitleClick="false" preserveHeaderStateOnScroll="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Detail Comparison" level="H1" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<OverflowToolbar>
					<Button text="Back" icon="sap-icon://nav-back" press=".onNavBack" />
					<ToolbarSeparator />
					<Button icon="sap-icon://arrow-top" tooltip="Previous change" press=".onPrevChange" enabled="{= ${detailCompare>/changeBlockCount} > 0 }" />
					<Button icon="sap-icon://arrow-bottom" tooltip="Next change" press=".onNextChange" enabled="{= ${detailCompare>/changeBlockCount} > 0 }" />
					<Text text="{detailCompare>/navPosition}" class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
					<ToolbarSeparator />
					<ObjectStatus text="+{detailCompare>/diffAdded}" state="Success" tooltip="Lines added" />
					<ObjectStatus text="-{detailCompare>/diffRemoved}" state="Error" tooltip="Lines removed" class="sapUiTinyMarginBegin" />
					<ObjectStatus text="~{detailCompare>/diffChanged}" state="Warning" tooltip="Lines changed" class="sapUiTinyMarginBegin" />
					<ToolbarSpacer />
					<Button
						text="Ask AI"
						icon="sap-icon://da"
						tooltip="Analyze this comparison with an AI assistant"
						press=".onOpenAiChat"
						enabled="{= !${detailCompare>/compareWorkspaceBusy} }" />
					<Button
						text="Send Mail"
						icon="sap-icon://email"
						type="Emphasized"
						press=".onSendMail"
						enabled="{= !${detailCompare>/compareWorkspaceBusy} }" />
				</OverflowToolbar>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox class="sapUiSmallMargin" busy="{detailCompare>/compareWorkspaceBusy}">
				<Panel expandable="true" expanded="false" class="sapUiSmallMarginBottom">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Change Review" level="H3" />
							<ObjectStatus
								text="{detailCompare>/changeBreaking} breaking"
								state="Error"
								icon="sap-icon://alert"
								class="sapUiSmallMarginBegin" />
							<ObjectStatus
								text="{detailCompare>/changeCompatible} compatible"
								state="Success"
								icon="sap-icon://accept"
								class="sapUiSmallMarginBegin" />
							<ToolbarSpacer />
							<SegmentedButton selectedKey="{detailCompare>/changeFilter}" selectionChange=".onChangeFilterSelect">
								<items>
									<SegmentedButtonItem key="all" text="All" />
									<SegmentedButtonItem key="Breaking" text="Breaking" />
									<SegmentedButtonItem key="Compatible" text="Compatible" />
								</items>
							</SegmentedButton>
						</OverflowToolbar>
					</headerToolbar>
					<content>
						<VBox>
							<Text text="{detailCompare>/changeHeadline}" class="sapUiTinyMarginBegin sapUiTinyMarginBottom" />
							<Table
								id="changeTable"
								items="{detailCompare>/changeRows}"
								growing="true"
								growingThreshold="50"
								mode="None"
								itemPress=".onChangeRowPress"
								noDataText="No changes in this category."
								width="100%">
								<columns>
									<Column width="22%" minScreenWidth="6rem"><Text text="Element" /></Column>
									<Column width="13%" minScreenWidth="Tablet" demandPopin="true"><Text text="Type" /></Column>
									<Column width="12%" minScreenWidth="Tablet" demandPopin="true"><Text text="Attribute" /></Column>
									<Column width="12%" minScreenWidth="Tablet" demandPopin="true"><Text text="Before" /></Column>
									<Column width="12%" minScreenWidth="Tablet" demandPopin="true"><Text text="After" /></Column>
									<Column width="11%"><Text text="Severity" /></Column>
									<Column width="18%" minScreenWidth="Tablet" demandPopin="true"><Text text="Reason" /></Column>
								</columns>
								<items>
									<ColumnListItem
										type="Active"
										highlight="{path: 'detailCompare>severity', formatter: '.formatSeverityState'}">
										<cells>
											<ObjectIdentifier title="{detailCompare>elementName}" text="{detailCompare>elementPath}" />
											<Text text="{detailCompare>elementType}" />
											<Text text="{detailCompare>attribute}" />
											<Text text="{path: 'detailCompare>oldValue', formatter: '.formatChangeValue'}" />
											<Text text="{path: 'detailCompare>newValue', formatter: '.formatChangeValue'}" />
											<ObjectStatus
												text="{detailCompare>severity}"
												state="{path: 'detailCompare>severity', formatter: '.formatSeverityState'}" />
											<Text text="{detailCompare>reason}" />
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</content>
				</Panel>

				<l:Splitter width="100%" height="{= ${ui>/isNarrowWidth} ? '54rem' : '34rem' }" orientation="{= ${ui>/isNarrowWidth} ? 'Vertical' : 'Horizontal' }" class="sapUiSmallMarginBottom">
					<Page title="Base Node Tree ({detailCompare>/baseDetailId})" showHeader="true" enableScrolling="false" class="versionDetailSplitPage">
						<layoutData>
							<l:SplitterLayoutData size="50%" resizable="true" />
						</layoutData>
						<content>
							<ScrollContainer id="baseTreeScroll" height="100%" width="100%" vertical="true" horizontal="false">
								<Tree id="baseTree" noDataText="{= ${detailCompare>/compareWorkspaceBusy} ? 'Loading...' : 'No data' }" items="{path: 'detailCompare>/baseTree', parameters: { arrayNames: ['children'], numberOfExpandedLevels: 1 }}" mode="SingleSelectMaster" selectionChange=".onBaseTreeSelectionChange">
									<StandardTreeItem highlight="{detailCompare>highlight}" title="{detailCompare>label}">
										<customData>
											<core:CustomData key="diffStatus" value="{= ${detailCompare>highlight} || 'None' }" writeToDom="true" xmlns:core="sap.ui.core" />
										</customData>
									</StandardTreeItem>
								</Tree>
							</ScrollContainer>
						</content>
					</Page>

					<Page title="Compare Node Tree ({detailCompare>/compareDetailId})" showHeader="true" enableScrolling="false" class="versionDetailSplitPage">
						<layoutData>
							<l:SplitterLayoutData size="auto" />
						</layoutData>
						<content>
							<ScrollContainer id="compareTreeScroll" height="100%" width="100%" vertical="true" horizontal="false">
								<Tree id="compareTree" noDataText="{= ${detailCompare>/compareWorkspaceBusy} ? 'Loading...' : 'No data' }" items="{path: 'detailCompare>/compareTree', parameters: { arrayNames: ['children'], numberOfExpandedLevels: 1 }}" mode="SingleSelectMaster" selectionChange=".onCompareTreeSelectionChange">
									<StandardTreeItem highlight="{detailCompare>highlight}" title="{detailCompare>label}">
										<customData>
											<core:CustomData key="diffStatus" value="{= String(${detailCompare>highlight}) || 'None' }" writeToDom="true" xmlns:core="sap.ui.core" />
										</customData>
									</StandardTreeItem>
								</Tree>
							</ScrollContainer>
						</content>
					</Page>
				</l:Splitter>

				<Toolbar id="xmlDiffToolbar" design="Transparent" class="sapUiTinyMarginTop">
					<Title text="XML Diff" level="H3" />
					<ToolbarSpacer />
					<SegmentedButton selectedKey="{detailCompare>/xmlViewMode}" selectionChange=".onXmlViewModeChange">
						<items>
							<SegmentedButtonItem key="all" text="All lines" icon="sap-icon://text-align-justified" />
							<SegmentedButtonItem key="changes" text="Changes only" icon="sap-icon://filter" />
						</items>
					</SegmentedButton>
				</Toolbar>

				<l:Splitter width="100%" height="{= ${ui>/isNarrowWidth} ? '58rem' : '36rem' }" orientation="{= ${ui>/isNarrowWidth} ? 'Vertical' : 'Horizontal' }">
				<Page title="Base XML ({detailCompare>/baseDetailId})" showHeader="true" enableScrolling="false" class="versionDetailSplitPage">
					<layoutData>
						<l:SplitterLayoutData size="50%" resizable="true" />
					</layoutData>
					<headerContent>
						<Button icon="sap-icon://copy" tooltip="Copy Base XML" press=".onCopyBaseXml" enabled="{= !!${detailCompare>/basePrettyXml} }" />
					</headerContent>
					<content>
							<ScrollContainer class="versionDetailXmlScroll" id="baseXmlScroll" width="100%" height="100%" horizontal="true" vertical="true">
								<Table id="baseDetailXmlTable" class="versionDetailXmlTable" width="100%" fixedLayout="false" growing="true" growingScrollToLoad="true" growingThreshold="100" items="{detailCompare>/baseXmlLines}" mode="None">
								<columns>
									<Column width="4rem"><Text text="#" /></Column>
									<Column width="auto"><Text text="Line" /></Column>
								</columns>
								<items>
									<ColumnListItem highlight="{detailCompare>highlight}">
										<customData>
											<core:CustomData key="diffStatus" value="{= ${detailCompare>highlight} || 'None' }" writeToDom="true" xmlns:core="sap.ui.core" />
											<core:CustomData key="linetype" value="{= ${detailCompare>lineType} || 'same' }" writeToDom="true" xmlns:core="sap.ui.core" />
										</customData>
										<cells>
											<Text text="{= ${detailCompare>lineNo} > 0 ? '' + ${detailCompare>lineNo} : '' }" class="versionDetailXmlIndex" />
											<FormattedText htmlText="{path: 'detailCompare>text', formatter: '.formatXmlLine'}" class="versionDetailXmlText" />
										</cells>
									</ColumnListItem>
								</items>
							</Table>
							</ScrollContainer>
						</content>
					</Page>
				<Page title="Compare XML ({detailCompare>/compareDetailId})" showHeader="true" enableScrolling="false" class="versionDetailSplitPage">
					<layoutData>
						<l:SplitterLayoutData size="auto" />
					</layoutData>
					<headerContent>
						<Button icon="sap-icon://copy" tooltip="Copy Compare XML" press=".onCopyCompareXml" enabled="{= !!${detailCompare>/comparePrettyXml} }" />
					</headerContent>
					<content>
							<ScrollContainer class="versionDetailXmlScroll" id="compareXmlScroll" width="100%" height="100%" horizontal="true" vertical="true">
								<Table id="compareDetailXmlTable" class="versionDetailXmlTable" width="100%" fixedLayout="false" growing="true" growingScrollToLoad="true" growingThreshold="100" items="{detailCompare>/compareXmlLines}" mode="None">
								<columns>
									<Column width="4rem"><Text text="#" /></Column>
									<Column width="auto"><Text text="Line" /></Column>
								</columns>
								<items>
									<ColumnListItem highlight="{detailCompare>highlight}">
										<customData>
											<core:CustomData key="diffStatus" value="{= ${detailCompare>highlight} || 'None' }" writeToDom="true" xmlns:core="sap.ui.core" />
											<core:CustomData key="linetype" value="{= ${detailCompare>lineType} || 'same' }" writeToDom="true" xmlns:core="sap.ui.core" />
										</customData>
										<cells>
											<Text text="{= ${detailCompare>lineNo} > 0 ? '' + ${detailCompare>lineNo} : '' }" class="versionDetailXmlIndex" />
											<FormattedText htmlText="{path: 'detailCompare>text', formatter: '.formatXmlLine'}" class="versionDetailXmlText" />
										</cells>
									</ColumnListItem>
								</items>
							</Table>
							</ScrollContainer>
						</content>
					</Page>
				</l:Splitter>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>
