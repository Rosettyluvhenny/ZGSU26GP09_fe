<mvc:View
	controllerName="com.zgp9.fe.controller.Home"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout">

	<Page id="homePage" title="Home" showHeader="false" busy="{home>/busy}">
		<content>
			<VBox class="sapUiMediumMargin">
				<Title text="{= 'Welcome back' + (${session>/userName} ? ', ' + ${session>/userName} : '') + '!' }" level="H2" class="sapUiSmallMarginBottom" />
				<Text text="Here's a snapshot of your registries and scan jobs." class="sapUiMediumMarginBottom" />

				<!-- KPI tiles -->
				<HBox wrap="Wrap" class="sapUiSmallMarginBottom">
					<GenericTile header="Total Registries" subheader="All services" press=".onNavigateRegistries" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
						<tileContent>
							<TileContent>
								<content>
									<NumericContent value="{home>/registryStats/total}" icon="sap-icon://database" withMargin="false" />
								</content>
							</TileContent>
						</tileContent>
					</GenericTile>
					<GenericTile header="Published" subheader="Live services" press=".onNavigateRegistries" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
						<tileContent>
							<TileContent>
								<content>
									<NumericContent value="{home>/registryStats/published}" icon="sap-icon://sys-enter-2" valueColor="Good" withMargin="false" />
								</content>
							</TileContent>
						</tileContent>
					</GenericTile>
					<GenericTile header="Unpublished" subheader="Not live" press=".onNavigateRegistries" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
						<tileContent>
							<TileContent>
								<content>
									<NumericContent value="{home>/registryStats/unpublished}" icon="sap-icon://pending" valueColor="Critical" withMargin="false" />
								</content>
							</TileContent>
						</tileContent>
					</GenericTile>
					<GenericTile header="Archived" subheader="Retired" press=".onNavigateRegistries" class="sapUiTinyMarginBottom">
						<tileContent>
							<TileContent>
								<content>
									<NumericContent value="{home>/registryStats/archive}" icon="sap-icon://box" valueColor="Error" withMargin="false" />
								</content>
							</TileContent>
						</tileContent>
					</GenericTile>
				</HBox>

				<Panel headerText="Quick Actions" expandable="false" class="sapUiSmallMarginBottom">
					<content>
						<OverflowToolbar>
							<Button text="Manage Registries" icon="sap-icon://business-objects-experience" type="Emphasized" press=".onNavigateRegistries" />
							<Button text="Scan Job Management" icon="sap-icon://activity-items" press=".onNavigateJobs" visible="{ui>/canExecuteScanJob}" />
							<ToolbarSpacer />
						</OverflowToolbar>
					</content>
				</Panel>

				<!-- Recent activity -->
				<l:Grid defaultSpan="L6 M12 S12">
					<Panel headerText="Recently Changed Registries" expandable="false">
						<content>
							<List items="{home>/recentRegistries}" noDataText="No registries yet.">
								<StandardListItem
									icon="sap-icon://database"
									title="{home>registryName}"
									description="{= ${home>serviceType} + ' · ' + ${home>lastChangedBy} + ' · ' + ${path: 'home>lastChangedAt', formatter: '.formatRelativeTime'} }"
									info="{home>statusText}"
									infoState="{path: 'home>status', formatter: '.formatStatusState'}"
									type="Active"
									press=".onRegistryPress" />
							</List>
						</content>
					</Panel>

					<Panel headerText="Recent Scan Jobs" expandable="false">
						<content>
							<List items="{home>/recentJobs}" noDataText="No scan jobs yet.">
								<StandardListItem
									icon="sap-icon://activity-items"
									title="{= 'Job ' + ${home>id} }"
									description="{= ${home>triggerType} + ' · ' + ${home>executedBy} + ' · ' + ${path: 'home>startedAt', formatter: '.formatRelativeTime'} }"
									info="{home>status}"
									infoState="{path: 'home>status', formatter: '.formatStatusState'}"
									type="Active"
									press=".onJobPress" />
							</List>
						</content>
					</Panel>
				</l:Grid>
			</VBox>
		</content>
	</Page>

</mvc:View>
