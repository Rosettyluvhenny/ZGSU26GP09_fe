<mvc:View
	controllerName="com.zgp9.fe.controller.Login"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core">

	<Page showHeader="false" class="loginPage" backgroundDesign="Solid">
		<content>
			<VBox class="loginHero" width="100%" justifyContent="Center" alignItems="Center">
				<VBox class="loginBrand" alignItems="Center">
					<core:Icon src="sap-icon://database" size="3.25rem" class="loginBrandIcon" />
					<Title text="Registry Control Center" level="H1" class="loginBrandTitle" />
					<Text text="OData Service Registry" class="loginBrandTagline" />
				</VBox>
				<Panel width="100%" class="loginCard">
					<content>
						<Text text="Sign in to manage registries, versions, and scan jobs." wrapping="true" class="sapUiSmallMarginBottom" />
						<form:Form editable="true" width="100%">
							<form:layout>
								<form:ColumnLayout />
							</form:layout>
							<form:formContainers>
								<form:FormContainer title="Credentials">
									<form:formElements>
										<form:FormElement label="Username">
											<form:fields>
												<Input value="{login>/userName}" placeholder="Enter username" submit=".onLogin" />
											</form:fields>
										</form:FormElement>
										<form:FormElement label="Password">
											<form:fields>
												<Input value="{login>/password}" type="Password" placeholder="Enter password" submit=".onLogin" />
											</form:fields>
										</form:FormElement>
									</form:formElements>
								</form:FormContainer>
							</form:formContainers>
						</form:Form>
						<Button text="Sign In" type="Emphasized" width="100%" press=".onLogin" busy="{ui>/loginBusy}" class="loginActions sapUiSmallMarginTop" />
					</content>
				</Panel>
			</VBox>
		</content>
	</Page>

</mvc:View>
