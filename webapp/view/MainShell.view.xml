<mvc:View
	controllerName="com.zgp9.fe.controller.MainShell"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:tnt="sap.tnt">

	<tnt:ToolPage id="shellPage" class="shellPage" sideExpanded="{ui>/sideNavVisible}">
		<tnt:header>
			<!--
				sap.tnt.ToolHeader, not sap.m.OverflowToolbar: on UI5 1.108 the ToolPage "header"
				aggregation accepts only sap.tnt.IToolHeader, and an OverflowToolbar here logs
				"is not valid for aggregation" and is not placed correctly. Newer UI5 relaxed the
				aggregation, which is why this worked on 1.149. ToolHeader extends
				OverflowToolbar, so the children below behave identically.
			-->
			<!--
				Header visibility, standalone vs embedded — see FLP_MIGRATION.md 3.3.

				Embedded in a launchpad the whole toolbar goes: the FLP shell bar already
				carries the app title, the user, the theme switch and logout, so showing them
				again is duplication; theme in particular belongs to FLP user settings, not to
				the app. Bound rather than deleted, because the standalone hosts (BTP, ABAP
				direct URL) have no shell bar and still need all four.

				There is no side-navigation toggle here any more. It was the one control the
				shell bar does NOT duplicate, so 3.3 kept the toolbar alive below 600px purely
				to host it — which left the button present on embedded phone but missing on
				embedded desktop. Keeping the toolbar at every width fixed that, but bought a
				full-width strip under the shell bar holding a single button. The toggle now
				lives in each routed page's own title bar (NavToggleButton.fragment.xml), which
				costs no chrome on either host and puts it in the same place standalone and
				embedded — so this toolbar is once again purely the four duplicated controls.
			-->
			<tnt:ToolHeader visible="{= !${ui>/isInLaunchpad} }">
				<Title text="{i18n>appTitle}" level="H3" />
				<ToolbarSpacer />
				<ObjectStatus text="{session>/userName}" state="Information" />
				<Button
					icon="{= ${ui>/isDarkTheme} ? 'sap-icon://light-mode' : 'sap-icon://dark-mode' }"
					tooltip="{= ${ui>/isDarkTheme} ? 'Switch to light theme' : 'Switch to dark theme' }"
					press=".onToggleTheme"
					type="Transparent" />
				<Button
					icon="sap-icon://log"
					text="Logout"
					press=".onLogout"
					type="Transparent" />
			</tnt:ToolHeader>
		</tnt:header>
		<tnt:sideContent>
			<tnt:SideNavigation expanded="true" visible="{ui>/permissionsLoaded}">
				<tnt:NavigationList selectedKey="{ui>/currentSection}">
					<tnt:NavigationListItem key="home" text="Home" icon="sap-icon://home" select=".onNavigateHome" />
					<tnt:NavigationListItem key="registries" text="Registry Management" icon="sap-icon://business-objects-experience" select=".onNavigateRegistries" />
					<tnt:NavigationListItem key="jobs" text="Scan Job Management" icon="sap-icon://activity-items" select=".onNavigateJobs" visible="{ui>/canExecuteScanJob}" />
					<tnt:NavigationListItem key="logs" text="Logs" icon="sap-icon://history" select=".onNavigateLogs" />
				</tnt:NavigationList>
			</tnt:SideNavigation>
		</tnt:sideContent>
		<tnt:mainContents>
			<f:FlexibleColumnLayout id="shellFcl" layout="{ui>/layout}" />
		</tnt:mainContents>
	</tnt:ToolPage>

</mvc:View>
