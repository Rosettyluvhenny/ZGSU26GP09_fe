<mvc:View
	controllerName="com.zgp9.fe.controller.MainShell"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:tnt="sap.tnt">

	<tnt:ToolPage id="shellPage" class="shellPage" sideExpanded="{ui>/sideNavVisible}">
		<tnt:header>
			<!--
				sap.tnt.ToolHeader, not sap.m.OverflowToolbar: on UI5 1.108 the ToolPage "header"
				aggregation accepts only sap.tnt.IToolHeader, and an OverflowToolbar here logs
				"is not valid for aggregation" and is not placed correctly. Newer UI5 relaxed the
				aggregation, which is why this worked on 1.149. ToolHeader extends
				OverflowToolbar, so the children below behave identically.
			-->
			<!--
				Header visibility, standalone vs embedded — see FLP_MIGRATION.md 3.3.

				Embedded in a launchpad, the FLP shell bar already carries the app title, the
				user, the theme switch and logout, so showing them again is duplication; theme
				in particular belongs to FLP user settings, not to the app. Each of those four
				is therefore hidden individually on `isInLaunchpad`, rather than deleted — the
				standalone hosts (BTP, ABAP direct URL) have no shell bar and still need them.

				The toolbar itself is unconditionally visible, because the menu button is the
				one control the FLP shell bar does NOT duplicate: it toggles this app's side
				navigation, which the shell knows nothing about. 3.3 originally dropped the
				whole toolbar when embedded and re-added it below 600px, where the side nav
				collapses to an overlay and the button is the only way back. That left the
				button — and so any way to collapse the nav — missing on embedded desktop while
				present on embedded phone, which reads as a bug rather than as the "convenience,
				not a function" trade-off 3.3 accepted. Embedded desktop now pays a one-button
				toolbar strip under the shell bar in exchange for consistent behaviour.
			-->
			<tnt:ToolHeader>
				<Button
					icon="sap-icon://menu2"
					tooltip="{= ${ui>/sideNavVisible} ? 'Hide navigation' : 'Show navigation' }"
					press=".onToggleSideNav"
					type="Transparent" />
				<Title text="{i18n>appTitle}" level="H3" visible="{= !${ui>/isInLaunchpad} }" />
				<ToolbarSpacer />
				<ObjectStatus text="{session>/userName}" state="Information" visible="{= !${ui>/isInLaunchpad} }" />
				<Button
					icon="{= ${ui>/isDarkTheme} ? 'sap-icon://light-mode' : 'sap-icon://dark-mode' }"
					tooltip="{= ${ui>/isDarkTheme} ? 'Switch to light theme' : 'Switch to dark theme' }"
					press=".onToggleTheme"
					type="Transparent"
					visible="{= !${ui>/isInLaunchpad} }" />
				<Button
					icon="sap-icon://log"
					text="Logout"
					press=".onLogout"
					type="Transparent"
					visible="{= !${ui>/isInLaunchpad} }" />
			</tnt:ToolHeader>
		</tnt:header>
		<tnt:sideContent>
			<tnt:SideNavigation expanded="true" visible="{ui>/permissionsLoaded}">
				<tnt:NavigationList selectedKey="{ui>/currentSection}">
					<tnt:NavigationListItem key="home" text="Home" icon="sap-icon://home" select=".onNavigateHome" />
					<tnt:NavigationListItem key="registries" text="Registry Management" icon="sap-icon://business-objects-experience" select=".onNavigateRegistries" />
					<tnt:NavigationListItem key="jobs" text="Scan Job Management" icon="sap-icon://activity-items" select=".onNavigateJobs" visible="{ui>/canExecuteScanJob}" />
					<tnt:NavigationListItem key="logs" text="Logs" icon="sap-icon://history" select=".onNavigateLogs" />
				</tnt:NavigationList>
			</tnt:SideNavigation>
		</tnt:sideContent>
		<tnt:mainContents>
			<f:FlexibleColumnLayout id="shellFcl" layout="{ui>/layout}" />
		</tnt:mainContents>
	</tnt:ToolPage>

</mvc:View>
