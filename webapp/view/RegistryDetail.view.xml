<mvc:View
	controllerName="com.zgp9.fe.controller.RegistryDetail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout">

	<f:DynamicPage id="registryDetailPage" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{registryDetail>/registry/registryName}" level="H1" />
				</f:heading>
				<f:snappedContent>
					<ObjectStatus text="{registryDetail>/registry/status}" state="{path: 'registryDetail>/registry/status', formatter: '.formatStatusState'}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<VBox width="100%" class="sapUiSmallMarginBottom">
					<Text text="{registryDetail>/registry/description}" wrapping="true" />
					<OverflowToolbar>
						<Button text="Back" icon="sap-icon://nav-back" press=".onNavBack" />
						<Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh" />
						<ToolbarSpacer />
					</OverflowToolbar>
					<HBox class="sapUiTinyMarginTop" wrap="Wrap">
						<Text text="{= 'Created By: ' + ${registryDetail>/registry/createdBy} }" class="sapUiTinyMarginEnd" />
						<Text text="{path: 'registryDetail>/registry/createdAt', formatter: '.formatDateTime'}" class="sapUiTinyMarginEnd" />
					</HBox>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox class="sapUiSmallMargin">
				<Panel headerText="Registry Information" expandable="false">
					<content>
						<l:Grid defaultSpan="L6 M6 S12" hSpacing="1" vSpacing="1">
							<Label text="Registry Name" />
							<Text text="{registryDetail>/registry/registryName}" />
							<Label text="Service Name" />
							<Text text="{registryDetail>/registry/serviceName}" />
							<Label text="Service Type" />
							<Text text="{registryDetail>/registry/serviceType}" />
							<Label text="Last Changed By" />
							<Text text="{registryDetail>/registry/lastChangedBy}" />
							<Label text="Last Changed At" />
							<Text text="{path: 'registryDetail>/registry/lastChangedAt', formatter: '.formatDateTime'}" />
						</l:Grid>
					</content>
				</Panel>

				<Panel headerText="Version Management" expandable="false" class="sapUiSmallMarginTop">
					<content>
						<Table items="{registryDetail>/versions}" busy="{registryDetail>/busy}" growing="true" mode="None">
							<columns>
								<Column width="10rem"><Text text="Version Number" /></Column>
								<Column width="11rem"><Text text="Created By" /></Column>
								<Column width="11rem"><Text text="Created At" /></Column>
								<Column width="16rem"><Text text="Comment" /></Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Text text="{registryDetail>versionNumber}" />
										<Text text="{registryDetail>createdBy}" />
										<Text text="{path: 'registryDetail>createdAt', formatter: '.formatDateTime'}" />
										<Text text="{registryDetail>comment}" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</content>
				</Panel>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>
