<mvc:View
	controllerName="com.zgp9.fe.controller.RegistryDetail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout">

	<f:DynamicPage id="registryDetailPage" toggleHeaderOnTitleClick="false" preserveHeaderStateOnScroll="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{registryDetail>/registry/groupName}" level="H1" />
				</f:heading>
				<f:snappedContent>
					<ObjectStatus text="{registryDetail>/registry/statusText}" state="{path: 'registryDetail>/registry/status', formatter: '.formatStatusState'}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<OverflowToolbar>
					<Button text="Back" icon="sap-icon://nav-back" press=".onNavBack" />
					<Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh" />
					<ToolbarSpacer />
					<Text text="{registryDetail>/selectionCountLabel}" />
					<Button text="Compare" type="Emphasized" enabled="{registryDetail>/canCompare}" press=".onComparePress" />
					<Button text="Generate Version" busy="{registryDetail>/generateBusy}" press=".onGenerateVersion" />
				</OverflowToolbar>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox class="sapUiSmallMargin" busy="{registryDetail>/busy}">
				<Panel headerText="Registry Information" expandable="false">
					<content>
						<form:SimpleForm layout="ResponsiveGridLayout" columnsL="2" columnsM="2" editable="false">
							<form:content>
							<Label text="ID" />
    <Text text="{registryDetail>/registry/groupId}" />

    <Label text="Registry Name" />
    <Text text="{registryDetail>/registry/groupName}" />

    <Label text="Service Name" />
    <Text text="{registryDetail>/registry/serviceName}" />

    <Label text="Service Type" />
    <Text text="{registryDetail>/registry/groupType}" />

    <Label text="Status Code" />
    <Text text="{registryDetail>/registry/status}" />

    <Label text="Version No." />
    <Text text="{registryDetail>/registry/versionNo}" />

    <Label text="Created By" />
    <Text text="{registryDetail>/registry/registeredBy}" />

    <Label text="Created At" />
    <Text text="{path: 'registryDetail>/registry/registeredAt', formatter: '.formatDateTime'}" />

    <Label text="Last Changed By" />
    <Text text="{registryDetail>/registry/lastChangedBy}" />

    <Label text="Last Changed At" />
    <Text text="{path: 'registryDetail>/registry/lastChangeAt', formatter: '.formatDateTime'}" />

    <Label text="Description" />
    <Text text="{registryDetail>/registry/description}" wrapping="true" />
							</form:content>
						</form:SimpleForm>
					</content>
				</Panel>

				<Panel headerText="Versions" expandable="false" class="sapUiSmallMarginTop">
					<content>
						<Table id="versionsTable" items="{registryDetail>/versions}" mode="MultiSelect" growing="true" selectionChange=".onVersionSelectionChange">
							<columns>
								<Column width="10rem"><Text text="Version Number" /></Column>
								<Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Created By" /></Column>
								<Column width="11rem"><Text text="Created At" /></Column>
								<Column width="16rem" minScreenWidth="Tablet" demandPopin="true"><Text text="TriggerType" /></Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Link text="{registryDetail>versionNo}" press=".onVersionPress" />
										<Text text="{registryDetail>createdBy}" />
										<Text text="{path: 'registryDetail>createdAt', formatter: '.formatDateTime'}" />
										<Text text="{registryDetail>comment}" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</content>
				</Panel>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>
