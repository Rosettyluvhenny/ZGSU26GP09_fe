<mvc:View
	controllerName="com.zgp9.fe.controller.RegistryList"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout">

	<f:DynamicPage id="registryListPage" toggleHeaderOnTitleClick="false" preserveHeaderStateOnScroll="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Registry Explorer" level="H1" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<VBox width="100%">
					<OverflowToolbar design="Transparent" style="Clear">
						<Button text="Create Registry" type="Emphasized" press=".onCreateRegistry" visible="{ui>/canCreate}" />
						<Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh" />
						<ToolbarSpacer />
						<Select selectedKey="{registryList>/searchField}" change=".onFilterChange" class="sapUiTinyMarginEnd">
							<core:Item key="all" text="All Fields" />
							<core:Item key="groupName" text="Registry Name" />
							<core:Item key="registryId" text="Registry ID" />
						</Select>
						<SearchField width="15rem" placeholder="Global search" value="{registryList>/search}" search=".onFilterChange" />
					</OverflowToolbar>
					<HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMarginTop">
						<VBox class="sapUiSmallMarginEnd">
							<Label text="Service Type" />
							<Select width="10rem" selectedKey="{registryList>/groupType}" change=".onFilterChange" items="{registryList>/groupTypes}">
								<core:Item key="{registryList>key}" text="{registryList>text}" />
							</Select>
						</VBox>
						<VBox class="sapUiSmallMarginEnd">
							<Label text="Status" />
							<Select width="10rem" selectedKey="{registryList>/status}" change=".onFilterChange" items="{registryList>/statuses}">
								<core:Item key="{registryList>key}" text="{registryList>text}" />
							</Select>
						</VBox>
						<VBox class="sapUiSmallMarginEnd">
							<Label text="Registry Name" />
							<Input width="12rem" value="{registryList>/groupName}" placeholder="Filter by Name" submit=".onFilterChange" />
						</VBox>
						<VBox>
							<Label text="Created By" />
							<Input width="12rem" value="{registryList>/registeredBy}" placeholder="Filter by User" submit=".onFilterChange" />
						</VBox>
					</HBox>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox width="100%" class="sapUiSmallMargin">
				<Table id="registryTable" items="{registryList>/items}" busy="{registryList>/busy}" mode="None" growing="true" sticky="ColumnHeaders">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Registries" level="H2" />
							<ToolbarSpacer />
							<Button icon="sap-icon://sort" press=".onSortPress" tooltip="Sort" />
							<ObjectStatus text="{= ${registryList>/items}.length + ' items' }" state="Information" class="sapUiSmallMarginBegin" />
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column width="16rem"><Text text="Registry Name" /></Column>
						<Column width="12rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Service Name" /></Column>
						<Column width="8rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Service Type" /></Column>
						<Column width="6rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Version No" /></Column>
						<Column width="9rem"><Text text="Current Status" /></Column>
						<Column minScreenWidth="1300px" demandPopin="true"><Text text="Created By" /></Column>
						<Column minScreenWidth="1300px" demandPopin="true"><Text text="Created At" /></Column>
						<Column minScreenWidth="1300px" demandPopin="true"><Text text="Last Changed By" /></Column>
						<Column minScreenWidth="1300px" demandPopin="true"><Text text="Last Changed At" /></Column>
						<Column width="10rem" minScreenWidth="Tablet" demandPopin="true" visible="{ui>/canUpdate}"><Text text="Actions" /></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRowPress">
							<cells>
								<ObjectIdentifier title="{registryList>groupName}" text="{registryList>description}" />
								<Text text="{registryList>serviceName}" />
								<ObjectStatus text="{registryList>groupType}" />
								<Text text="{registryList>versionNo}" />
								<ObjectStatus text="{registryList>statusText}" state="{path: 'registryList>status', formatter: '.formatStatusState'}" />
								<Text text="{registryList>registeredBy}" />
								<Text text="{path: 'registryList>registeredAt', formatter: '.formatDateTime'}" />
								<Text text="{registryList>lastChangedBy}" />
								<Text text="{path: 'registryList>lastChangeAt', formatter: '.formatDateTime'}" />
								<HBox wrap="Wrap" renderType="Bare" justifyContent="Start" visible="{ui>/canUpdate}">
									<Button text="Edit" type="Transparent" press=".onEditRegistry" visible="{ui>/canUpdate}" />
								</HBox>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>
