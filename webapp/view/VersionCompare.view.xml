<mvc:View
	controllerName="com.zgp9.fe.controller.VersionCompare"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f">

	<f:DynamicPage id="versionComparePage" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Version Comparison" level="H1" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<OverflowToolbar>
					<Button text="Back" icon="sap-icon://nav-back" press=".onNavBack" />
					<Button text="Copy Left XML" press=".onCopyLeftXml" />
					<Button text="Copy Right XML" press=".onCopyRightXml" />
				</OverflowToolbar>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox class="sapUiSmallMargin" busy="{versionCompare>/busy}">
				<Panel headerText="Change" expandable="false">
					<content>
						<Table items="{versionCompare>/change}" growing="true">
							<columns>
								<Column width="18rem"><Text text="Service Def" /></Column>
								<Column width="16rem"><Text text="Base Detail" /></Column>
								<Column width="16rem"><Text text="Compare Detail" /></Column>
								<Column width="10rem"><Text text="Type" /></Column>
								<Column width="9rem"><Text text="Action" /></Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Text text="{versionCompare>serviceDefId}" />
										<Text text="{versionCompare>baseDetailId}" />
										<Text text="{versionCompare>compareDetailId}" />
										<ObjectStatus text="{versionCompare>changeType}" state="{path: 'versionCompare>changeType', formatter: '.formatStatusState'}" />
										<Button text="View Detail" type="Transparent" press=".onViewDetail" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</content>
				</Panel>

				<Panel headerText="Different" expandable="false" class="sapUiSmallMarginTop">
					<content>
						<Table items="{versionCompare>/differ}" growing="true">
							<columns>
								<Column width="18rem"><Text text="Service Def" /></Column>
								<Column width="16rem"><Text text="Base Detail" /></Column>
								<Column width="16rem"><Text text="Compare Detail" /></Column>
								<Column width="10rem"><Text text="Type" /></Column>
								<Column width="9rem"><Text text="Action" /></Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Text text="{versionCompare>serviceDefId}" />
										<Text text="{versionCompare>baseDetailId}" />
										<Text text="{versionCompare>compareDetailId}" />
										<ObjectStatus text="{versionCompare>changeType}" state="{path: 'versionCompare>changeType', formatter: '.formatStatusState'}" />
										<Button text="View Detail" type="Transparent" press=".onViewDetail" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</content>
				</Panel>

				<Panel headerText="Unchange" expandable="false" class="sapUiSmallMarginTop">
					<content>
						<Table items="{versionCompare>/unchange}" growing="true">
							<columns>
								<Column width="18rem"><Text text="Service Def" /></Column>
								<Column width="16rem"><Text text="Base Detail" /></Column>
								<Column width="16rem"><Text text="Compare Detail" /></Column>
								<Column width="10rem"><Text text="Type" /></Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Text text="{versionCompare>serviceDefId}" />
										<Text text="{versionCompare>baseDetailId}" />
										<Text text="{versionCompare>compareDetailId}" />
										<ObjectStatus text="{versionCompare>changeType}" state="{path: 'versionCompare>changeType', formatter: '.formatStatusState'}" />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</content>
				</Panel>


			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>
