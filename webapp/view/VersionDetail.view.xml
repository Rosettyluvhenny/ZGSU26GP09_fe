<mvc:View
	controllerName="com.zgp9.fe.controller.VersionDetail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core">

	<f:DynamicPage id="versionDetailPage" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{= 'Version ' + ${versionDetail>/version/versionNumber} + ' Details' }" level="H1" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<OverflowToolbar>
					<Button text="Back" icon="sap-icon://nav-back" press=".onNavBack" />
					<Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh" />
					<ToolbarSpacer />
				</OverflowToolbar>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox class="sapUiSmallMargin" busy="{versionDetail>/busy}">
				<Panel headerText="Version Summary" expandable="false">
					<content>
						<l:Grid defaultSpan="L6 M6 S12" hSpacing="1" vSpacing="1">
							<Label text="Version Number" />
							<Text text="{versionDetail>/version/versionNumber}" />
							<Label text="Created By" />
							<Text text="{versionDetail>/version/createdBy}" />
							<Label text="Created At" />
							<Text text="{path: 'versionDetail>/version/createdAt', formatter: '.formatDateTime'}" />
							<Label text="Comment" />
							<Text text="{versionDetail>/version/comment}" wrapping="true" />
						</l:Grid>
					</content>
				</Panel>

				<Panel headerText="Detail" expandable="false" class="sapUiSmallMarginTop">
					<content>
						<HBox width="100%" alignItems="Start">
							<Select
								class="versionDetailDetailSelect"
								width="100%"
								selectedKey="{versionDetail>/selectedDetail/id}"
								change=".onDetailChange"
								items="{versionDetail>/details}">
									<core:Item key="{versionDetail>id}" text="{= ${versionDetail>serviceDefinition} + ' / ' + ${versionDetail>serviceHash} }" />
								</Select>
						</HBox>
						<l:Grid class="sapUiSmallMarginTop" defaultSpan="L12 M12 S12" hSpacing="0.5" vSpacing="0.5">
							<Label text="DetailId" />
							<Text text="{versionDetail>/selectedDetail/id}" wrapping="true" />
							<Label text="ServiceDefId" />
							<Text text="{versionDetail>/selectedDetail/serviceDefinition}" wrapping="true" />
							<Label text="ServiceHash" />
							<Text text="{versionDetail>/selectedDetail/serviceHash}" wrapping="true" />
							<Label text="VersionId" />
							<Text text="{versionDetail>/selectedDetail/versionId}" wrapping="true" />
							<Label text="GroupId" />
							<Text text="{versionDetail>/selectedDetail/groupId}" wrapping="true" />
							<Label text="LastChangeAt" />
							<Text text="{path: 'versionDetail>/selectedDetail/lastChangedAt', formatter: '.formatDateTime'}" wrapping="true" />
						</l:Grid>
					</content>
				</Panel>

				<l:Splitter width="100%" height="40rem" class="sapUiSmallMarginTop">
					<Page title="Node Tree" showHeader="true" enableScrolling="false" busy="{versionDetail>/selectedDetailBusy}" class="versionDetailSplitPage">
						<layoutData>
							<l:SplitterLayoutData size="24rem" resizable="true" />
						</layoutData>
						<content>
							<ScrollContainer height="100%" width="100%" vertical="true" horizontal="true">
								<Tree class="versionDetailNodeTree" id="versionDetailTree" items="{path: 'treeModel>/', parameters: { arrayNames: ['children'] }}" mode="SingleSelectMaster" selectionChange=".onNodeSelectionChange">
									<StandardTreeItem title="{treeModel>label}" />
								</Tree>
							</ScrollContainer>
						</content>
					</Page>

					<Page title="XML" showHeader="true" enableScrolling="false" busy="{versionDetail>/selectedDetailBusy}" class="versionDetailSplitPage">
						<layoutData>
							<l:SplitterLayoutData size="auto" />
						</layoutData>
						<content>
							<ScrollContainer class="versionDetailXmlScroll" width="100%" height="100%" horizontal="true" vertical="true">
								<Table id="selectedDetailXmlTable" class="versionDetailXmlTable" width="100%" fixedLayout="true" growing="true" growingScrollToLoad="true" growingThreshold="100" items="{versionDetail>/selectedDetailLines}" mode="None">
									<columns>
										<Column width="4rem"><Text text="#" /></Column>
										<Column width="auto"><Text text="Line" /></Column>
									</columns>
									<items>
										<ColumnListItem>
											<cells>
												<Text text="{versionDetail>lineNo}" class="versionDetailXmlIndex" />
												<Text text="{versionDetail>text}" wrapping="false" class="versionDetailXmlText" />
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</ScrollContainer>
						</content>
					</Page>
				</l:Splitter>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>
