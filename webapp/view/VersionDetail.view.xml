<mvc:View
	controllerName="com.zgp9.fe.controller.VersionDetail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout">

	<f:DynamicPage id="versionDetailPage" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{= 'Version ' + ${versionDetail>/version/versionNumber} + ' Details' }" level="H1" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<OverflowToolbar>
					<Button text="Back" icon="sap-icon://nav-back" press=".onNavBack" />
					<Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh" />
					<ToolbarSpacer />
				</OverflowToolbar>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox class="sapUiSmallMargin" busy="{versionDetail>/busy}">
				<Panel headerText="Version Summary" expandable="false">
					<content>
						<l:Grid defaultSpan="L6 M6 S12" hSpacing="1" vSpacing="1">
							<Label text="Version Number" />
							<Text text="{versionDetail>/version/versionNumber}" />
							<Label text="Created By" />
							<Text text="{versionDetail>/version/createdBy}" />
							<Label text="Created At" />
							<Text text="{path: 'versionDetail>/version/createdAt', formatter: '.formatDateTime'}" />
							<Label text="Comment" />
							<Text text="{versionDetail>/version/comment}" wrapping="true" />
						</l:Grid>
					</content>
				</Panel>

				<HBox width="100%" class="sapUiSmallMarginTop" alignItems="Start">
					<Panel headerText="Details" expandable="false" width="20rem" class="sapUiTinyMarginEnd">
						<content>
							<List items="{versionDetail>/details}" mode="SingleSelectMaster" selectionChange=".onDetailSelect" includeItemInSelection="true">
								<StandardListItem title="{versionDetail>id}" description="{= ${versionDetail>serviceDefinition} + ' / ' + ${versionDetail>serviceHash} }" />
							</List>
						</content>
					</Panel>

					<Panel headerText="Node Tree" expandable="false" width="24rem" busy="{versionDetail>/selectedDetailBusy}" class="sapUiTinyMarginEnd">
						<content>
							<Tree id="versionDetailTree" items="{path: 'versionDetail>/selectedDetailTree', parameters: { arrayNames: ['children'] }}" mode="SingleSelectMaster" selectionChange=".onNodeSelectionChange">
								<StandardTreeItem title="{versionDetail>label}" />
							</Tree>
						</content>
					</Panel>

					<Panel headerText="XML" expandable="false" busy="{versionDetail>/selectedDetailBusy}">
						<layoutData>
							<FlexItemData growFactor="1" />
						</layoutData>
						<content>
							<VBox width="100%">
								<Text text="{= 'XML length: ' + ${versionDetail>/selectedDetailXml}.length }" />
								<TextArea id="selectedDetailXmlArea" value="{versionDetail>/selectedDetailXml}" width="100%" rows="36" editable="false" />
							</VBox>
						</content>
					</Panel>
				</HBox>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>
