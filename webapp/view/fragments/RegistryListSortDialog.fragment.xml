<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<ViewSettingsDialog
		id="registryListSortDialog"
		title="Sort Registries"
		confirm=".onSortConfirm">
		<sortItems>
			<ViewSettingsItem text="Group Name" key="groupName" selected="true" />
			<ViewSettingsItem text="Group Type" key="groupType" />
			<ViewSettingsItem text="Version No" key="versionNo" />
			<ViewSettingsItem text="Current Status" key="statusText" />
			<ViewSettingsItem text="Created By" key="registeredBy" />
			<ViewSettingsItem text="Created At" key="registeredAt" />
			<ViewSettingsItem text="Last Changed By" key="lastChangedBy" />
			<ViewSettingsItem text="Last Changed At" key="lastChangeAt" />
		</sortItems>
	</ViewSettingsDialog>
</core:FragmentDefinition>
