{
    "xsappname": "zgp9-fe",
    "tenant-mode": "dedicated",
    "scopes": [
        {
            "name": "$XSAPPNAME.User",
            "description": "General app access"
        },
        {
            "name": "$XSAPPNAME.AiUser",
            "description": "May spend the shared AI provider quota via the /ai proxy routes"
        }
    ],
    "role-templates": [
        {
            "name": "User",
            "description": "General app access",
            "scope-references": [
                "$XSAPPNAME.User"
            ]
        },
        {
            "name": "AiUser",
            "description": "Access to the AI assistant",
            "scope-references": [
                "$XSAPPNAME.AiUser"
            ]
        }
    ],
    "role-collections": [
        {
            "name": "ZGP9_User",
            "description": "Access to ZGP9 app",
            "role-template-references": [
                "$XSAPPNAME.User"
            ]
        },
        {
            "name": "ZGP9_AiUser",
            "description": "Access to the ZGP9 AI assistant (granted separately: it spends a shared paid quota)",
            "role-template-references": [
                "$XSAPPNAME.AiUser"
            ]
        }
    ],
    "oauth2-configuration": {
        "redirect-uris": [
            "https://7f4c3e60trial-dev-zgp9-fe-approuter.cfapps.us10-001.hana.ondemand.com/**"
        ],
        "credential-types": ["binding-secret", "x509"]
    }
}